# une-api local development example. Copy to .env and fill values.
# No real secrets belong in this file.
# Contract endpoints are served under /api/v1; /health stays at the root.
PORT=3001
AUTH_MODE=mock
# Matches infrastructure/docker-compose.yml defaults; password from infrastructure/.env.
DATABASE_URL=postgres://une:<UNE_DB_PASSWORD>@localhost:5432/une
# S3-compatible endpoint (MinIO from infrastructure/docker-compose.yml).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=une-documents
