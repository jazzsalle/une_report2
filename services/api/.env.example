# une-api local development example. Copy to .env and fill values.
# No real secrets belong in this file.
# Contract endpoints are served under /api/v1; /health stays at the root.
PORT=3001
# 'mock' enables mock-JWT issuance (never in environments with unmasked data);
# any other value disables issuance until the real T3Q SSO binding (OB-01).
AUTH_MODE=mock
# HS256 signing key for UNE JWTs. Required (>=32 chars) when AUTH_MODE=mock.
# Generate per machine: openssl rand -hex 32 — environment secret, no default.
UNE_AUTH_JWT_SECRET=<openssl rand -hex 32>
UNE_ACCESS_TOKEN_TTL_SEC=900
UNE_REFRESH_TOKEN_TTL_SEC=43200
# Only for admin-URL test setups (SET LOCAL ROLE per transaction); leave empty
# when DATABASE_URL already connects as une_app.
UNE_DB_RUNTIME_ROLE=
# Matches infrastructure/docker-compose.yml defaults; secrets from infrastructure/.env.
# Runtime connects as the non-superuser app role (une_app) so RLS is enforced;
# the superuser role (une) is for migrations/ops only (CC-004 decides tooling).
DATABASE_URL=postgres://une_app:<UNE_DB_APP_PASSWORD>@localhost:5432/une
# S3-compatible endpoint (MinIO from infrastructure/docker-compose.yml).
# Credentials are the bucket-scoped service account, never the MinIO root.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs for browsers; equals OBJECT_STORAGE_ENDPOINT
# locally, differs once the backend runs in a container/cloud host.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=une-documents
OBJECT_STORAGE_ACCESS_KEY=<UNE_STORAGE_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<UNE_STORAGE_SECRET_KEY>
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# --- CC-170 업로드·브라우저 경계 -------------------------------------------
# 업로드 티켓·다운로드 URL에 들어가는, 브라우저가 실제로 도달하는 API 주소.
# 리버스 프록시 뒤에서는 Host 헤더를 신뢰할 수 없으므로 설정으로 받는다.
UNE_PUBLIC_API_BASE_URL=http://localhost:3001
# 업로드 상한(바이트)과 티켓 수명(초). 티켓은 인증 우회 경로이므로 짧게 둔다.
UNE_UPLOAD_MAX_BYTES=52428800
UNE_UPLOAD_TICKET_TTL_SEC=900
# 브라우저 허용 출처(쉼표 구분). 비면 CORS 헤더를 내보내지 않는다(같은 출처만).
# 와일드카드는 기동에서 거부된다 — 허용 출처는 배포마다 아는 값이다.
UNE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# CC-200: 상황 Provider 목업의 시나리오 훅(query.mockScenario)을 켠다.
# 운영에서는 켜지 않는다 — 시험 훅이 운영 요청 경로에 남으면 계약이 그 필드를
# 약속하게 된다(ADR-33 D19). E2E는 설정 객체로 직접 켠다.
UNE_SITUATION_MOCK_SCENARIOS=false

# CC-200: Provider 한 곳당 수집 제한시간(ms). 동기 수집이라 이것이 없으면
# 느린 Provider 하나가 HTTP 요청을 무기한 붙잡는다(ADR-33 수용 한계 2).
UNE_SITUATION_PROVIDER_TIMEOUT_MS=10000

# ── 지식문서 등록 정책 (CC-220, ADR-36 D6) ──
# UNE_KNOWLEDGE_MAX_FILE_BYTES=52428800
# 비우면 설계 06 US-SIT-009 기준 목록(PDF/HWPX/DOCX/PPTX/XLSX/TXT). 와일드카드 금지.
# UNE_KNOWLEDGE_ALLOWED_MIME_TYPES=application/pdf,text/plain
# UNE_KNOWLEDGE_MAX_UPLOAD_ATTEMPTS=3
# ⚠ 보안 완화 토글. **기본 false를 유지하라.**
# OB-15로 AV 엔진이 없어 file_object.scan_status는 영구 PENDING이다. true로 두면
# 검사 결과가 없는 파일이 UNI로 올라가고, "검사했다"에 준하는 기록이 남는다
# (ADR-36 D6). 켜야 한다면 그 사실이 배포 기록에 남는 것이 이 변수의 목적이다.
# UNE_KNOWLEDGE_ALLOW_SCAN_PENDING=false
