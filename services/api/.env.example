# une-api local development example. Copy to .env and fill values.
# No real secrets belong in this file.
# Contract endpoints are served under /api/v1; /health stays at the root.
PORT=3001
AUTH_MODE=mock
# Set by CC-002/CC-004; placeholder shape only.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/une
# S3-compatible endpoint (MinIO locally, CC-002).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
