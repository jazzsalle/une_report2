{
  "name": "@une/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start:watch": "node --watch dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@une/domain": "workspace:*",
    "@une/hwpx-engine": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0",
    "@une/provider-adapters": "workspace:*"
  }
}
