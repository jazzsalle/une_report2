# une-worker local development example. Copy to .env and fill values.
# No real secrets belong in this file.
# Matches infrastructure/docker-compose.yml defaults; secrets from infrastructure/.env.
# Runtime connects as the non-superuser app role (une_app) so RLS is enforced.
# ⚠ 전제조건 (OB-17, 아직 충족되지 않았다): 이 로그인 롤은 une_worker와
# une_retention의 **멤버**여야 한다. 저장소 어디에도 그 GRANT가 없어서
# (initdb·마이그레이션·compose·CI 전부 확인) 아래 값 그대로 띄우면 워커는
# 첫 트랜잭션의 SET LOCAL ROLE에서 42501로 죽고 보존 스윕도 돌지 않는다.
# une_app에 멤버십을 주는 것으로 때우면 안 된다 — 기본 INHERIT가 정책 대상
# 자격까지 물려줘 API 런타임이 전 테넌트 원문을 보게 된다(ADR-35 수용 한계 4).
DATABASE_URL=postgres://une_app:<UNE_DB_APP_PASSWORD>@localhost:5432/une
OUTBOX_POLL_INTERVAL_MS=5000
# ── T3Q plan adapter selection (CC-125, ADR-26 D6) ──
# mock-legacy (default) | legacy-http | mock-target-v2. Mocks are NEVER
# actual T3Q support (capability registry); production + mock fails startup
# unless UNE_ALLOW_MOCK_PROVIDER=true is set for an approved demo.
UNE_T3Q_PLAN_ADAPTER=mock-legacy
# legacy-http only — every value is REQUIRED, no fallbacks (OB-01):
# UNE_T3Q_BASE_URL=<provider base URL, never guessed from the transcript>
# UNE_T3Q_AUTH_MODE=none|header  (none is for local fixture servers only)
# UNE_T3Q_AUTH_HEADER_NAME=<agreed header name>
# UNE_T3Q_AUTH_TOKEN=<agreed token — real value only in .env, never committed>
# Optional; defaults are the UNE baseline 5000/60000ms (design 10 §4.2),
# NOT provider-agreed values:
# UNE_T3Q_CONNECT_TIMEOUT_MS=5000
# UNE_T3Q_RESPONSE_TIMEOUT_MS=60000
# RPT-002 transport (CC-130, ADR-27 D5): default false — the assumed SSE
# framing (OB-01) stays off the operational path; enable only for the
# CC-400 real-contract verification.
# UNE_T3Q_CONTENT_STREAM=false
# ── Provider 원문·요청조건 보존기간 (OB-16, 마이그레이션 0026) ──
# 사용자 결정 2026-08-09: 1개월 뒤 페이로드만 비운다(행은 남긴다).
# 해시·항목수·수신시각·상태는 그대로 남아 감사에 답한다.
# UNE_PAYLOAD_RETENTION_DAYS=30
# 정리 전용 롤. une_worker와 같으면 기동 실패한다 — 워커에 권한을 얹으면
# ADR-33 D2(워커는 상황 계열 테이블에 닿지 않는다)가 조용히 뒤집힌다.
# UNE_RETENTION_ROLE=une_retention
# UNE_RETENTION_BATCH_SIZE=500
# UNE_RETENTION_INTERVAL_MS=21600000
# false로 두면 원문이 무기한 남는다(기동 시 경고). 기본은 켬.
# UNE_RETENTION_ENABLED=true
# Worker handles long-running HWPX/export jobs, so it needs the same
# bucket-scoped storage service account as the API (never the MinIO root).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=une-documents
OBJECT_STORAGE_ACCESS_KEY=<UNE_STORAGE_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<UNE_STORAGE_SECRET_KEY>
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
