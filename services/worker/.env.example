# une-worker local development example. Copy to .env and fill values.
# No real secrets belong in this file.
# Matches infrastructure/docker-compose.yml defaults; secrets from infrastructure/.env.
# 워커는 **자기 로그인 롤**로 붙는다 (OB-17, 마이그레이션 0050에서 닫혔다).
# une_worker_app은 une_worker·une_retention의 멤버이되 INHERIT FALSE라,
# 워커가 매 트랜잭션에서 SET LOCAL ROLE을 해야만 권한이 선다 — 빼먹은 경로는
# 조용히 통과하지 않고 권한 오류로 드러난다.
#
# une_app으로 붙이지 말 것. une_app에 멤버십을 주는 것으로 때우면 기본 INHERIT가
# 정책 대상 자격까지 물려줘 API 런타임이 전 테넌트 원문을 보게 된다
# (ADR-35 D2/D4).
DATABASE_URL=postgres://une_worker_app:<UNE_DB_WORKER_PASSWORD>@localhost:5432/une
OUTBOX_POLL_INTERVAL_MS=5000
# ── T3Q plan adapter selection (CC-125, ADR-26 D6) ──
# mock-legacy (default) | legacy-http | mock-target-v2. Mocks are NEVER
# actual T3Q support (capability registry); production + mock fails startup
# unless UNE_ALLOW_MOCK_PROVIDER=true is set for an approved demo.
UNE_T3Q_PLAN_ADAPTER=mock-legacy
# legacy-http only — every value is REQUIRED, no fallbacks (OB-01):
# UNE_T3Q_BASE_URL=<provider base URL, never guessed from the transcript>
# UNE_T3Q_AUTH_MODE=none|header  (none is for local fixture servers only)
# UNE_T3Q_AUTH_HEADER_NAME=<agreed header name>
# UNE_T3Q_AUTH_TOKEN=<agreed token — real value only in .env, never committed>
# Optional; defaults are the UNE baseline 5000/60000ms (design 10 §4.2),
# NOT provider-agreed values:
# UNE_T3Q_CONNECT_TIMEOUT_MS=5000
# UNE_T3Q_RESPONSE_TIMEOUT_MS=60000
# RPT-002 transport (CC-130, ADR-27 D5): default false — the assumed SSE
# framing (OB-01) stays off the operational path; enable only for the
# CC-400 real-contract verification.
# UNE_T3Q_CONTENT_STREAM=false
# ── Provider 원문·요청조건 보존기간 (OB-16, 마이그레이션 0026) ──
# 사용자 결정 2026-08-09: 1개월 뒤 페이로드만 비운다(행은 남긴다).
# 해시·항목수·수신시각·상태는 그대로 남아 감사에 답한다.
# UNE_PAYLOAD_RETENTION_DAYS=30
# 정리 전용 롤. une_worker와 같으면 기동 실패한다 — 워커에 권한을 얹으면
# ADR-33 D2(워커는 상황 계열 테이블에 닿지 않는다)가 조용히 뒤집힌다.
# UNE_RETENTION_ROLE=une_retention
# UNE_RETENTION_BATCH_SIZE=500
# UNE_RETENTION_INTERVAL_MS=21600000
# false로 두면 원문이 무기한 남는다(기동 시 경고). 기본은 켬.
# UNE_RETENTION_ENABLED=true
# Worker handles long-running HWPX/export jobs, so it needs the same
# bucket-scoped storage service account as the API (never the MinIO root).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=une-documents
OBJECT_STORAGE_ACCESS_KEY=<UNE_STORAGE_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<UNE_STORAGE_SECRET_KEY>
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ── 지식문서 UNI 전송 (CC-220, ADR-36) ──
# UNE_KNOWLEDGE_ENABLED=true
# UNE_KNOWLEDGE_UPLOAD_INTERVAL_MS=5000
# UNE_KNOWLEDGE_POLL_INTERVAL_MS=15000
# UNE_KNOWLEDGE_POLL_BATCH_SIZE=20
# ── UNI 어댑터 선택 ──
# mock (기본) | http. mock은 UNI 지원이 아니다 — production에서 쓰려면
# UNE_ALLOW_MOCK_PROVIDER=true를 명시해야 기동한다.
UNE_UNI_KNOWLEDGE_ADAPTER=mock
# http일 때 주소와 자격증명은 **필수**다 — 그것만은 추측할 수 없다.
# UNE_UNI_BASE_URL=<협의된 base URL>
# UNE_UNI_USERNAME=<서비스 계정>
# UNE_UNI_PASSWORD=<비밀값 — .env에만, 커밋 금지>
#
# 아래 셋은 **CC-410(2026-08-14)에서 실측**했으므로 기본값이 있다(ADR-50 D6).
# 값을 적지 않으면 실측값을 쓴다. UNI가 바꾸면 여기서 맞춘다 — 코드는 그대로다.
# UNE_UNI_UPLOAD_FILE_FIELD=file      # multipart 파일 파트 이름
# UNE_UNI_TOKEN_FIELD=token           # /auth/login 응답의 토큰 필드
# UNE_UNI_LOGIN_ACCOUNT_FIELD=account # /auth/login 요청의 계정 필드 (username 아니다)
# 응답 필드명은 설계 08 §1.9 기준선을 기본값으로 쓴다. 실제 이름이 오면
# 코드 변경 없이 여기서 맞춘다.
# UNE_UNI_FIELD_DOCUMENT_ID=doc_id
# UNE_UNI_FIELD_FILE_NAME=filename
# UNE_UNI_FIELD_MESSAGE=message
# UNE_UNI_FIELD_STATUS=status
# 설계 08 §1.14: 업로드 60초. 나머지는 UNE 기준선이며 provider 합의값이 아니다.
# UNE_UNI_UPLOAD_TIMEOUT_MS=60000
# UNE_UNI_REQUEST_TIMEOUT_MS=30000

# ── UNI SOP 생성 (CC-240, ADR-38) ──
# 러너를 끄면 SOP 잡이 QUEUED로 남는다. 기동 로그가 그 사실을 적는다.
# UNE_SOP_ENABLED=true
# mock (기본) | http. 지식문서 어댑터와 같은 규칙 — production에서 mock은
# UNE_ALLOW_MOCK_PROVIDER=true 없이는 기동하지 않는다.
UNE_UNI_SOP_ADAPTER=mock
# http일 때 UNE_UNI_BASE_URL이 필요하다(위 지식문서 항목과 같은 값).
# `/chat/json`은 설계 08 §1.8이 "인증 없음 B2B"로 적었으므로 토큰을 붙이지 않는다.
#
# 요청 본문 필드명은 **계약이 없다**(OB-04). 번들 스냅샷의 /chat/json은
# 요청·응답이 additionalProperties:true라 정의된 필드가 하나도 없어, 아래
# 기본값은 UNI 지식문서 검색과 같은 이름을 쓴 UNE의 가정이다.
# UNE_UNI_SOP_FIELD_QUERY=query
# UNE_UNI_SOP_FIELD_DOC_IDS=doc_ids
# 설계 08 §1.14: 첫 이벤트 30초, 전체 5분.
# UNE_UNI_SOP_FIRST_EVENT_TIMEOUT_MS=30000
# UNE_UNI_SOP_TOTAL_TIMEOUT_MS=300000

# -- 전파 채널 (CC-270, ADR-41) --
# 릴레이를 끄면 전파가 PENDING으로 쌓인다. 기동 로그가 그 사실을 적는다.
# UNE_OUTBOX_ENABLED=true
#
# 실패 시나리오 훅. **설정으로만 켠다** - 운영자의 데이터가 실패를 지어내면
# 안 된다(ADR-33 D19). 수신자 참조에 .channel-down. / .channel-reject. /
# .bad-address. 를 심으면 각각 재시도 대상 / 채널 거절 / 주소 오류가 된다.
# UNE_CHANNEL_SCENARIOS=false
#
# 발송 지연 흉내(ms). 테스트는 0을 쓴다.
# UNE_CHANNEL_LATENCY_MS=0
#
# SYSTEM 외 세 채널은 실제 계약이 없어(OB-06) 시뮬레이션이다 - 보냈다고
# 기록하지만 아무 데도 가지 않는다. 그 사실이 기동 로그·전파 상태·시도
# 기록에 드러난다.
