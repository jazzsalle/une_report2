# Local development only. Copy to infrastructure/.env and set passwords.
# Never commit infrastructure/.env or real credentials.

# PostgreSQL 16
UNE_DB_USER=une
UNE_DB_PASSWORD=
UNE_DB_NAME=une
UNE_DB_PORT=5432

# MinIO (S3-compatible object storage)
UNE_MINIO_ROOT_USER=une-minio
UNE_MINIO_ROOT_PASSWORD=
UNE_MINIO_API_PORT=9000
UNE_MINIO_CONSOLE_PORT=9001
UNE_MINIO_BUCKET=une-documents
