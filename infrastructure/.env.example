# Local development only. Copy to infrastructure/.env and set passwords/keys.
# Never commit infrastructure/.env or real credentials.
# Passwords/keys must be quote-free; `openssl rand -hex 16` output is safe.

# Bind address for published ports. Loopback by default (local-only);
# widen deliberately only if another device must reach these services.
UNE_BIND_ADDRESS=127.0.0.1

# PostgreSQL 16
UNE_DB_USER=une
UNE_DB_PASSWORD=
UNE_DB_NAME=une
UNE_DB_PORT=5432
# Non-superuser runtime role (RLS enforced); created on first initdb.
UNE_DB_APP_USER=une_app
UNE_DB_APP_PASSWORD=

# MinIO (S3-compatible object storage)
# Root account is for humans/bootstrap only; services use the UNE_STORAGE_* key.
UNE_MINIO_ROOT_USER=une-minio
UNE_MINIO_ROOT_PASSWORD=
UNE_MINIO_API_PORT=9000
UNE_MINIO_CONSOLE_PORT=9001
UNE_MINIO_BUCKET=une-documents
# Bucket-scoped service account created by minio-init (least privilege).
UNE_STORAGE_ACCESS_KEY=
UNE_STORAGE_SECRET_KEY=
