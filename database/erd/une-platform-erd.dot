digraph G {
  graph [rankdir=LR, splines=ortho, bgcolor="white", fontname="Malgun Gothic"];
  node [shape=plain, fontname="Malgun Gothic"];
  edge [color="#7F8C8D", arrowsize=0.7];
  subgraph cluster_IAM { label="IAM"; color="#D9EAF7"; style="rounded";
    tenant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>tenant</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">tenant_code</TD></TR><TR><TD ALIGN="LEFT">tenant_name</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">timezone</TD></TR></TABLE>>];
    organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>organization</B></TD></TR><TR><TD ALIGN="LEFT">organization_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">parent_id</TD></TR><TR><TD ALIGN="LEFT">org_code</TD></TR><TR><TD ALIGN="LEFT">org_name</TD></TR></TABLE>>];
    app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>app_user</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">external_user_id</TD></TR><TR><TD ALIGN="LEFT">login_id</TD></TR><TR><TD ALIGN="LEFT">display_name</TD></TR></TABLE>>];
    role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>role</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">role_code</TD></TR><TR><TD ALIGN="LEFT">role_name</TD></TR><TR><TD ALIGN="LEFT">scope_type</TD></TR></TABLE>>];
    permission [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>permission</B></TD></TR><TR><TD ALIGN="LEFT">permission_id</TD></TR><TR><TD ALIGN="LEFT">permission_code</TD></TR><TR><TD ALIGN="LEFT">resource_type</TD></TR><TR><TD ALIGN="LEFT">action</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR></TABLE>>];
    user_role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>user_role</B></TD></TR><TR><TD ALIGN="LEFT">user_role_id</TD></TR><TR><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">valid_from</TD></TR></TABLE>>];
    user_session [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#D9EAF7"><TR><TD><B>user_session</B></TD></TR><TR><TD ALIGN="LEFT">session_id</TD></TR><TR><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT">refresh_hash</TD></TR><TR><TD ALIGN="LEFT">issued_at</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD></TR></TABLE>>];
  }
  subgraph cluster_PLAN_DOC { label="PLAN_DOC"; color="#E2F0D9"; style="rounded";
    plan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>plan</B></TD></TR><TR><TD ALIGN="LEFT">plan_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">hazard_type</TD></TR><TR><TD ALIGN="LEFT">management_phase</TD></TR></TABLE>>];
    plan_context_snapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>plan_context_snapshot</B></TD></TR><TR><TD ALIGN="LEFT">context_snapshot_id</TD></TR><TR><TD ALIGN="LEFT">plan_id</TD></TR><TR><TD ALIGN="LEFT">version_no</TD></TR><TR><TD ALIGN="LEFT">context_json</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD></TR></TABLE>>];
    toc_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>toc_version</B></TD></TR><TR><TD ALIGN="LEFT">toc_version_id</TD></TR><TR><TD ALIGN="LEFT">plan_id</TD></TR><TR><TD ALIGN="LEFT">version_no</TD></TR><TR><TD ALIGN="LEFT">source_type</TD></TR><TR><TD ALIGN="LEFT">base_snapshot_id</TD></TR></TABLE>>];
    toc_node [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>toc_node</B></TD></TR><TR><TD ALIGN="LEFT">toc_node_id</TD></TR><TR><TD ALIGN="LEFT">toc_version_id</TD></TR><TR><TD ALIGN="LEFT">parent_node_id</TD></TR><TR><TD ALIGN="LEFT">node_key</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR></TABLE>>];
    generation_job [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>generation_job</B></TD></TR><TR><TD ALIGN="LEFT">job_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">job_type</TD></TR><TR><TD ALIGN="LEFT">aggregate_type</TD></TR><TR><TD ALIGN="LEFT">aggregate_id</TD></TR></TABLE>>];
    document [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>document</B></TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">document_type</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">source_file_id</TD></TR></TABLE>>];
    document_revision [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>document_revision</B></TD></TR><TR><TD ALIGN="LEFT">revision_id</TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">revision_no</TD></TR><TR><TD ALIGN="LEFT">parent_revision_id</TD></TR><TR><TD ALIGN="LEFT">ir_json</TD></TR></TABLE>>];
    document_block [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>document_block</B></TD></TR><TR><TD ALIGN="LEFT">block_id</TD></TR><TR><TD ALIGN="LEFT">revision_id</TD></TR><TR><TD ALIGN="LEFT">stable_block_key</TD></TR><TR><TD ALIGN="LEFT">block_type</TD></TR><TR><TD ALIGN="LEFT">parent_block_id</TD></TR></TABLE>>];
    change_set [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>change_set</B></TD></TR><TR><TD ALIGN="LEFT">change_set_id</TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">base_revision_id</TD></TR><TR><TD ALIGN="LEFT">result_revision_id</TD></TR><TR><TD ALIGN="LEFT">client_mutation_id</TD></TR></TABLE>>];
    template_profile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>template_profile</B></TD></TR><TR><TD ALIGN="LEFT">template_profile_id</TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">profile_version</TD></TR><TR><TD ALIGN="LEFT">analysis_status</TD></TR><TR><TD ALIGN="LEFT">profile_json</TD></TR></TABLE>>];
    style_prototype [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>style_prototype</B></TD></TR><TR><TD ALIGN="LEFT">prototype_id</TD></TR><TR><TD ALIGN="LEFT">template_profile_id</TD></TR><TR><TD ALIGN="LEFT">prototype_key</TD></TR><TR><TD ALIGN="LEFT">prototype_type</TD></TR><TR><TD ALIGN="LEFT">source_locator_json</TD></TR></TABLE>>];
    file_object [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>file_object</B></TD></TR><TR><TD ALIGN="LEFT">file_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">storage_key</TD></TR><TR><TD ALIGN="LEFT">original_name</TD></TR><TR><TD ALIGN="LEFT">mime_type</TD></TR></TABLE>>];
    export_job [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E2F0D9"><TR><TD><B>export_job</B></TD></TR><TR><TD ALIGN="LEFT">export_id</TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">revision_id</TD></TR><TR><TD ALIGN="LEFT">format</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
  }
  subgraph cluster_SITUATION { label="SITUATION"; color="#FFF2CC"; style="rounded";
    situation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>situation</B></TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">mode</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">hazard_type</TD></TR></TABLE>>];
    fact_source [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>fact_source</B></TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">provider_code</TD></TR><TR><TD ALIGN="LEFT">source_type</TD></TR><TR><TD ALIGN="LEFT">source_name</TD></TR><TR><TD ALIGN="LEFT">source_uri</TD></TR></TABLE>>];
    situation_fact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>situation_fact</B></TD></TR><TR><TD ALIGN="LEFT">fact_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">fact_type</TD></TR><TR><TD ALIGN="LEFT">fact_key</TD></TR><TR><TD ALIGN="LEFT">value_json</TD></TR></TABLE>>];
    fact_conflict [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>fact_conflict</B></TD></TR><TR><TD ALIGN="LEFT">conflict_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">fact_key</TD></TR><TR><TD ALIGN="LEFT">candidate_fact_ids</TD></TR><TR><TD ALIGN="LEFT">conflict_type</TD></TR></TABLE>>];
    situation_snapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>situation_snapshot</B></TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">version_no</TD></TR><TR><TD ALIGN="LEFT">facts_json</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD></TR></TABLE>>];
    provider_job [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>provider_job</B></TD></TR><TR><TD ALIGN="LEFT">provider_job_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">provider_code</TD></TR><TR><TD ALIGN="LEFT">request_json</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
    knowledge_document [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>knowledge_document</B></TD></TR><TR><TD ALIGN="LEFT">knowledge_document_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">file_id</TD></TR><TR><TD ALIGN="LEFT">document_type</TD></TR></TABLE>>];
    evidence_set [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>evidence_set</B></TD></TR><TR><TD ALIGN="LEFT">evidence_set_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">query_text</TD></TR><TR><TD ALIGN="LEFT">filters_json</TD></TR></TABLE>>];
    evidence_item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF2CC"><TR><TD><B>evidence_item</B></TD></TR><TR><TD ALIGN="LEFT">evidence_item_id</TD></TR><TR><TD ALIGN="LEFT">evidence_set_id</TD></TR><TR><TD ALIGN="LEFT">knowledge_document_id</TD></TR><TR><TD ALIGN="LEFT">provider_chunk_id</TD></TR><TR><TD ALIGN="LEFT">rank_no</TD></TR></TABLE>>];
  }
  subgraph cluster_SOP_TASK { label="SOP_TASK"; color="#FCE4D6"; style="rounded";
    sop [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>sop</B></TD></TR><TR><TD ALIGN="LEFT">sop_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">hazard_type</TD></TR></TABLE>>];
    sop_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>sop_version</B></TD></TR><TR><TD ALIGN="LEFT">sop_version_id</TD></TR><TR><TD ALIGN="LEFT">sop_id</TD></TR><TR><TD ALIGN="LEFT">version_no</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">graph_hash</TD></TR></TABLE>>];
    sop_node [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>sop_node</B></TD></TR><TR><TD ALIGN="LEFT">node_id</TD></TR><TR><TD ALIGN="LEFT">sop_version_id</TD></TR><TR><TD ALIGN="LEFT">node_key</TD></TR><TR><TD ALIGN="LEFT">node_type</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR></TABLE>>];
    sop_edge [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>sop_edge</B></TD></TR><TR><TD ALIGN="LEFT">edge_id</TD></TR><TR><TD ALIGN="LEFT">sop_version_id</TD></TR><TR><TD ALIGN="LEFT">from_node_id</TD></TR><TR><TD ALIGN="LEFT">to_node_id</TD></TR><TR><TD ALIGN="LEFT">condition_expr</TD></TR></TABLE>>];
    sop_run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>sop_run</B></TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">sop_version_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">mode</TD></TR></TABLE>>];
    task [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>task</B></TD></TR><TR><TD ALIGN="LEFT">task_id</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">node_id</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
    task_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>task_event</B></TD></TR><TR><TD ALIGN="LEFT">task_event_id</TD></TR><TR><TD ALIGN="LEFT">task_id</TD></TR><TR><TD ALIGN="LEFT">event_type</TD></TR><TR><TD ALIGN="LEFT">event_time</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR></TABLE>>];
    dispatch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>dispatch</B></TD></TR><TR><TD ALIGN="LEFT">dispatch_id</TD></TR><TR><TD ALIGN="LEFT">task_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">message_type</TD></TR><TR><TD ALIGN="LEFT">message_body</TD></TR></TABLE>>];
    dispatch_recipient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FCE4D6"><TR><TD><B>dispatch_recipient</B></TD></TR><TR><TD ALIGN="LEFT">recipient_id</TD></TR><TR><TD ALIGN="LEFT">dispatch_id</TD></TR><TR><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT">organization_id</TD></TR><TR><TD ALIGN="LEFT">channel</TD></TR></TABLE>>];
  }
  subgraph cluster_EVENT_JOURNAL { label="EVENT_JOURNAL"; color="#E4DFEC"; style="rounded";
    execution_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>execution_event</B></TD></TR><TR><TD ALIGN="LEFT">execution_event_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">aggregate_type</TD></TR><TR><TD ALIGN="LEFT">aggregate_id</TD></TR></TABLE>>];
    outbox_message [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>outbox_message</B></TD></TR><TR><TD ALIGN="LEFT">outbox_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">aggregate_type</TD></TR><TR><TD ALIGN="LEFT">aggregate_id</TD></TR><TR><TD ALIGN="LEFT">event_type</TD></TR></TABLE>>];
    outbox_attempt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>outbox_attempt</B></TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">outbox_id</TD></TR><TR><TD ALIGN="LEFT">attempt_no</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR></TABLE>>];
    journal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>journal</B></TD></TR><TR><TD ALIGN="LEFT">journal_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">document_id</TD></TR><TR><TD ALIGN="LEFT">period_start</TD></TR></TABLE>>];
    journal_projection_item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>journal_projection_item</B></TD></TR><TR><TD ALIGN="LEFT">projection_item_id</TD></TR><TR><TD ALIGN="LEFT">journal_id</TD></TR><TR><TD ALIGN="LEFT">section_key</TD></TR><TR><TD ALIGN="LEFT">source_event_ids</TD></TR><TR><TD ALIGN="LEFT">fact_payload_json</TD></TR></TABLE>>];
    evaluation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>evaluation</B></TD></TR><TR><TD ALIGN="LEFT">evaluation_id</TD></TR><TR><TD ALIGN="LEFT">situation_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">evaluation_type</TD></TR><TR><TD ALIGN="LEFT">overall_score</TD></TR></TABLE>>];
    improvement_action [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>improvement_action</B></TD></TR><TR><TD ALIGN="LEFT">action_id</TD></TR><TR><TD ALIGN="LEFT">evaluation_id</TD></TR><TR><TD ALIGN="LEFT">action_text</TD></TR><TR><TD ALIGN="LEFT">owner_user_id</TD></TR><TR><TD ALIGN="LEFT">due_at</TD></TR></TABLE>>];
    audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>audit_log</B></TD></TR><TR><TD ALIGN="LEFT">audit_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">action</TD></TR><TR><TD ALIGN="LEFT">resource_type</TD></TR></TABLE>>];
    notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#E4DFEC"><TR><TD><B>notification</B></TD></TR><TR><TD ALIGN="LEFT">notification_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT">notification_type</TD></TR><TR><TD ALIGN="LEFT">severity</TD></TR></TABLE>>];
  }
  organization -> tenant;
  app_user -> organization;
  plan -> tenant;
  plan_context_snapshot -> plan;
  toc_version -> plan;
  document -> plan;
  document_revision -> document;
  situation -> tenant;
  situation_fact -> situation;
  situation_fact -> fact_source;
  situation_snapshot -> situation;
  evidence_set -> situation_snapshot;
  sop -> situation;
  sop_version -> sop;
  sop_node -> sop_version;
  sop_edge -> sop_node;
  sop_run -> sop_version;
  task -> sop_run;
  task_event -> task;
  execution_event -> situation;
  outbox_message -> task;
  journal -> situation;
  journal_projection_item -> execution_event;
  audit_log -> tenant;
}