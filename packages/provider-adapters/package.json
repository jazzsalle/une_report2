    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@une/domain": "workspace:*",
    "undici": "^8.9.0"
  }
