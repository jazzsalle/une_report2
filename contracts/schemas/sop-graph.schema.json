{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.une.local/sop-graph.schema.json",
  "title": "SOP Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "hazardType",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hazardType": {
      "type": "string"
    },
    "warningLevel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "관심",
        "주의",
        "경계",
        "심각",
        null
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "evidenceSetId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKey",
        "nodeType",
        "title",
        "position"
      ],
      "properties": {
        "nodeKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,79}$"
        },
        "nodeType": {
          "type": "string",
          "enum": [
            "START",
            "ACTION",
            "DECISION",
            "NOTE",
            "END"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "task": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "decision": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "priority"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
