{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.une.local/common-error.schema.json",
  "title": "UNE Common Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "error",
    "meta"
  ],
  "properties": {
    "success": {
      "const": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,4}(-[0-9]{3})?$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "recoverable": {
          "type": "boolean"
        },
        "userAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rejectedValue": {}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "requestId",
        "correlationId",
        "timestamp",
        "schemaVersion"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "string"
        }
      }
    }
  }
}
